		{
			"name": "Login User",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const jsonData = pm.response.json();\r",
							"pm.environment.set(\"jwtToken\",jsonData.data.login.access_token);\r",
							"pm.environment.set(\"userId\",parseInt(jsonData.data.login.user.id));",
							"pm.test(\"Response status code is 200\", function () {",
							"    pm.expect(pm.response.code).to.eql(200);",
							"});",
							"",
							"",
							"pm.test(\"Access token must be present\", function () {",
							"    const responseData = pm.response.json();",
							"    ",
							"    pm.expect(responseData).to.be.an('object');",
							"    pm.expect(responseData.data).to.exist;",
							"    pm.expect(responseData.data.login).to.exist;",
							"    pm.expect(responseData.data.login.access_token).to.exist.and.to.be.a('string').and.to.have.lengthOf.above(0, \"Access token should not be empty\");",
							"});",
							"",
							"",
							"pm.test(\"Validate the user object structure\", function () {",
							"    const responseData = pm.response.json();",
							"",
							"    pm.expect(responseData).to.be.an('object');",
							"    pm.expect(responseData.data).to.be.an('object');",
							"    pm.expect(responseData.data.login).to.be.an('object');",
							"    pm.expect(responseData.data.login.user).to.be.an('object');",
							"",
							"    const user = responseData.data.login.user;",
							"    pm.expect(user).to.have.all.keys('id', 'email', 'name', 'role');",
							"    ",
							"    pm.expect(user.id).to.be.a('number');",
							"    pm.expect(user.email).to.be.a('string').and.to.match(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/, \"Email format is invalid\");",
							"    pm.expect(user.name).to.be.a('string');",
							"    pm.expect(user.role).to.be.a('string');",
							"});",
							"",
							"",
							"pm.test(\"Email is in a valid format\", function () {",
							"    const responseData = pm.response.json();",
							"    ",
							"    pm.expect(responseData).to.be.an('object');",
							"    pm.expect(responseData.data).to.exist;",
							"    pm.expect(responseData.data.login).to.exist;",
							"    pm.expect(responseData.data.login.user).to.exist;",
							"    ",
							"    const email = responseData.data.login.user.email;",
							"    const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;",
							"    ",
							"    pm.expect(email).to.match(emailRegex, \"Email format is invalid\");",
							"});",
							"",
							"",
							"pm.test(\"Role must be one of the expected values\", function () {",
							"    const responseData = pm.response.json();",
							"    const expectedRoles = [\"admin\", \"user\", \"guest\"]; // Add other expected roles as necessary",
							"",
							"    pm.expect(responseData).to.be.an('object');",
							"    pm.expect(responseData.data.login).to.exist;",
							"    pm.expect(responseData.data.login.user).to.exist;",
							"    pm.expect(expectedRoles).to.include(responseData.data.login.user.role);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
